{
  "name": "uniswap-lp-tool",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:pnl": "node scripts/pnl-accounting.test.mjs",
    "test:rpc": "node scripts/rpc-scheduler.test.mjs",
    "test:flow": "tsx scripts/flow-events.test.mjs",
    "test:dlmm": "node scripts/dlmm-distribution.test.mjs",
    "test:dlmm-layout": "tsx scripts/dlmm-layout.test.mjs",
    "test:dlmm-groups": "node scripts/dlmm-groups.test.mjs",
    "test:mint-payment": "node scripts/mint-payment.test.mjs",
    "test:usd-range": "tsx scripts/usd-range.test.mjs",
    "test:chains": "tsx scripts/chain-config.test.mjs",
    "test:tax-hook-ui": "tsx scripts/directional-tax-hook.test.mjs",
    "contracts:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-forge.ps1 build",
    "contracts:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-forge.ps1 test -vv",
    "contracts:artifact": "node scripts/export-directional-tax-artifact.mjs",
    "index:flow": "tsx scripts/build-flow-index.mjs",
    "test": "npm run test:pnl && npm run test:rpc && npm run test:flow && npm run test:dlmm && npm run test:dlmm-layout && npm run test:dlmm-groups && npm run test:mint-payment && npm run test:usd-range && npm run test:chains && npm run test:tax-hook-ui",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.55.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@uniswap/v4-core": "^1.0.2",
    "@uniswap/v4-periphery": "^1.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
